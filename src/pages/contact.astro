---
import Layout from '~/layouts/PageLayout.astro';
import { createBreadcrumbSchema } from '~/utils/structured-data';

const email = 'info@szcomo.com';
const emailHref = `mailto:${email}`;

const metadata = {
  title: 'Project Review Contact',
  description:
    'Send drawings, CAD files, material targets, equipment specifications, quantities, and acceptance requirements to Como Precision for project review.',
  openGraph: {
    images: [
      {
        url: '~/assets/images/como/og-como.webp',
        width: 1200,
        height: 630,
      },
    ],
    type: 'website',
  },
  structuredData: createBreadcrumbSchema([
    { name: 'Home', item: '/' },
    { name: 'Contact', item: '/contact/' },
  ]),
};
---

<Layout metadata={metadata}>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500 dark:text-slate-400">Contact</p>
      <h1
        class="mt-4 max-w-3xl text-4xl font-semibold leading-tight tracking-normal text-slate-950 dark:text-white sm:text-5xl"
      >
        Send drawings, material targets, equipment specs, quantities, and acceptance requirements.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">
        We review advanced material, 3D printing, technical ceramic, metal material, equipment, component, finishing,
        and inspection requirements.
      </p>
      <a class="btn-primary mt-8" href={emailHref}>Email {email}</a>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 sm:px-6 md:grid-cols-3">
      <div>
        <h2 class="text-lg font-semibold text-slate-950 dark:text-white">Project basics</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
          Send drawings, STEP files, material grade, equipment or component specs, quantity, and delivery target.
        </p>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-slate-950 dark:text-white">Technical details</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
          Add tolerance, surface finish, heat treatment, conductivity, density, inspection, packaging, or trade needs.
        </p>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-slate-950 dark:text-white">Response path</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
          We reply by email with next-step questions, feasibility notes, or quotation follow-up.
        </p>
      </div>
    </div>
  </section>
</Layout>
