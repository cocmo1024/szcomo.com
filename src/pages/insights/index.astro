---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import { getInsightHref, getInsightReadingTime, getPublishedInsights } from '~/utils/insights';
import { createBreadcrumbSchema, createItemListSchema } from '~/utils/structured-data';

const entries = await getPublishedInsights();
const featuredEntry = entries.find((entry) => entry.data.featured) || entries[0];
const remainingEntries = featuredEntry ? entries.filter((entry) => entry.id !== featuredEntry.id) : [];

const metadata = {
  title: 'Insights & News',
  description:
    'Technical articles, project guidance, and company news from Como Precision in one focused resource page.',
  openGraph: {
    type: 'website',
  },
  structuredData: [
    createBreadcrumbSchema([{ name: 'Home', item: '/' }, { name: 'Insights & News' }]),
    ...(entries.length
      ? [
          createItemListSchema(
            'Como Precision insights and news',
            entries.map((entry) => ({
              name: entry.data.title,
              description: entry.data.description,
              url: getInsightHref(entry),
            }))
          ),
        ]
      : []),
  ],
};
---

<Layout metadata={metadata}>
  <section class="border-b border-white/[0.08] py-14 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 sm:px-6 lg:grid-cols-[0.82fr_1.18fr] lg:items-end">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">
          Knowledge desk
        </p>
        <h1 class="mt-4 text-4xl font-semibold tracking-normal text-slate-950 dark:text-white md:text-6xl">
          Insights & News
        </h1>
      </div>
      <p class="max-w-2xl text-base leading-7 text-slate-600 dark:text-slate-300 md:text-lg md:leading-8">
        Technical articles, practical project guidance, and company updates—organized in one place for engineering and
        procurement teams.
      </p>
    </div>
  </section>

  {
    featuredEntry ? (
      <section class="py-12 md:py-16">
        <div class="mx-auto max-w-6xl px-4 sm:px-6">
          <a
            href={getInsightHref(featuredEntry)}
            class="group grid gap-8 border-b border-white/[0.1] pb-12 md:grid-cols-[0.7fr_1.3fr] md:items-start md:pb-16"
          >
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
                Featured · {featuredEntry.data.category}
              </p>
              <p class="mt-4 text-sm text-slate-500 dark:text-slate-500">
                <time datetime={featuredEntry.data.publishDate.toISOString()}>
                  {featuredEntry.data.publishDate.toLocaleDateString('en-US', {
                    month: 'long',
                    day: 'numeric',
                    year: 'numeric',
                    timeZone: 'UTC',
                  })}
                </time>
                <span aria-hidden="true"> · </span>
                {getInsightReadingTime(featuredEntry)} min read
              </p>
            </div>
            <div>
              <h2 class="text-3xl font-semibold tracking-normal text-slate-950 transition group-hover:text-slate-700 dark:text-white dark:group-hover:text-slate-200 md:text-5xl">
                {featuredEntry.data.title}
              </h2>
              <p class="mt-5 max-w-2xl text-base leading-7 text-slate-600 dark:text-slate-400">
                {featuredEntry.data.description}
              </p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-slate-900 dark:text-slate-200">
                Read article <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
              </span>
            </div>
          </a>

          {remainingEntries.length > 0 && (
            <div class="divide-y divide-white/[0.08]">
              {remainingEntries.map((entry) => (
                <article class="grid gap-4 py-8 md:grid-cols-[10rem_1fr_auto] md:items-start md:gap-8">
                  <div class="text-sm leading-6 text-slate-500 dark:text-slate-500">
                    <p class="font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">
                      {entry.data.category}
                    </p>
                    <time datetime={entry.data.publishDate.toISOString()}>
                      {entry.data.publishDate.toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                        year: 'numeric',
                        timeZone: 'UTC',
                      })}
                    </time>
                  </div>
                  <div>
                    <h2 class="text-xl font-semibold tracking-normal text-slate-950 dark:text-white md:text-2xl">
                      <a class="transition hover:text-slate-700 dark:hover:text-slate-200" href={getInsightHref(entry)}>
                        {entry.data.title}
                      </a>
                    </h2>
                    <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600 dark:text-slate-400">
                      {entry.data.description}
                    </p>
                  </div>
                  <a
                    href={getInsightHref(entry)}
                    class="inline-flex items-center gap-2 text-sm font-semibold text-slate-800 dark:text-slate-300"
                    aria-label={`Read ${entry.data.title}`}
                  >
                    {getInsightReadingTime(entry)} min <Icon name="tabler:arrow-right" class="h-4 w-4" />
                  </a>
                </article>
              ))}
            </div>
          )}
        </div>
      </section>
    ) : (
      <section class="py-14 md:py-20">
        <div class="mx-auto max-w-6xl px-4 sm:px-6">
          <div class="grid gap-8 border-y border-white/[0.08] py-10 md:grid-cols-[0.72fr_1.28fr] md:py-14">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
              Editorial archive
            </p>
            <div class="max-w-2xl">
              <h2 class="text-2xl font-semibold tracking-normal text-slate-950 dark:text-white md:text-3xl">
                Publications will appear here.
              </h2>
              <p class="mt-4 text-base leading-7 text-slate-600 dark:text-slate-400">
                This resource is reserved for technical articles, project guidance, and verified company updates. No
                articles have been published yet.
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="pb-14 md:pb-20">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 sm:px-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500 dark:text-slate-400">
          Project consultation
        </p>
        <h2 class="mt-3 text-3xl font-semibold tracking-normal text-slate-950 dark:text-white">
          Need a technical review before the next publication?
        </h2>
        <p class="mt-4 text-sm leading-6 text-slate-600 dark:text-slate-400">
          Send drawings, material targets, equipment specifications, quantities, and acceptance requirements for an
          initial routing review.
        </p>
      </div>
      <a class="btn-primary self-start shrink-0" href="mailto:info@szcomo.com">Contact Como</a>
    </div>
  </section>
</Layout>
